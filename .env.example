# Mode: "demo" | "firebase"
VITE_API_MODE=demo

# Firebase config (only needed for firebase mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use Firebase emulators
VITE_USE_EMULATORS=true

# --- Admin scripts (scripts/) ---

# Firebase Admin SDK - service account key (production only, never commit)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firebase project ID (used by admin scripts in emulator mode)
FIREBASE_PROJECT_ID=commande-qr-demo

# Emulators (set these to use emulators with admin scripts)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Domain for QR code URLs
QR_BASE_URL=https://commande-qr.web.app
